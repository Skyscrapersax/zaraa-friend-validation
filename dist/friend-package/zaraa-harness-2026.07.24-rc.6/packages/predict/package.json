{
  "name": "@zaraa/predict",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "predict",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --output-dir native --no-js --dts bindings.generated.d.ts",
    "build:debug": "napi build --platform --output-dir native --no-js --dts bindings.generated.d.ts",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
