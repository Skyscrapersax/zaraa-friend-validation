{
  "name": "@zaraa/sandbox",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaraa-ai/zaraa.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/zaraa-ai/zaraa#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zaraa/shared": "workspace:*",
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "tsup": "^8.5.1",
    "vitest": "^4.1.5"
  }
}
